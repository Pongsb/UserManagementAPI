@baseUrl = http://localhost:5080
@token = REPLACE_WITH_YOUR_LOCAL_TOKEN
@userId = 1

### List users
GET {{baseUrl}}/users
Authorization: Bearer {{token}}

### Create a user and copy its returned ID to userId above
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Demo User",
  "email": "demo.user@example.com"
}

### Get one user
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}

### Update
PUT {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated User",
  "email": "updated.user@example.com"
}

### Validation failure expects 400
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "",
  "email": "invalid"
}

### Invalid token expects 401
GET {{baseUrl}}/users
Authorization: Bearer deliberately-invalid

### Delete expects 204
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}

### Missing user expects 404 after delete
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}
